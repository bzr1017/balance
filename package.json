{
  "name": "balance",
  "private": true,
  "version": "0.1.0",
  "description": "Balance – vérnyomásnapló, orvosi dokumentumok és foci statisztika (web, iOS, Android)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "native:add": "npm run build && npx cap add ios && npx cap add android && npm run icons",
    "native:sync": "npm run build && npx cap sync",
    "ios": "npm run native:sync && npx cap open ios",
    "android": "npm run native:sync && npx cap open android",
    "icons": "capacitor-assets generate --iconBackgroundColor \"#1e8a5a\" --iconBackgroundColorDark \"#1e8a5a\" --splashBackgroundColor \"#ffffff\" --splashBackgroundColorDark \"#0e1612\""
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.3",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.2.1",
    "typescript": "~5.9.0",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
